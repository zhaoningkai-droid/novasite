# Example only. Keep real runtime.env outside the repository and mode 0600.
# Initial account creation is an explicit one-time offline operation.
PLATFORM_DEPLOYMENT_MODE="single-ecs"
PLATFORM_DOMAINS_ENABLED="true"
PLATFORM_ROOT_DOMAIN=example.com
PLATFORM_ADMIN_HOST=admin.example.com
NEXT_PUBLIC_SERVER_URL=https://admin.example.com
DATABASE_URL="REPLACE_PRIVATE_VALUE"
DATABASE_TLS_ENABLED="true"
DATABASE_CA_FILE="/srv/novasite-config/tls/ca.crt"
DATABASE_WEB_POOL_MAX="5"
DATABASE_TRANSLATION_POOL_MAX="2"
DATABASE_NOTIFICATION_POOL_MAX="1"
DATABASE_MIGRATOR_POOL_MAX="2"
DATABASE_CONNECTION_LIMIT="30"
DATABASE_RESERVED_CONNECTIONS="10"
DATABASE_CONNECTION_TIMEOUT_MS="10000"
DATABASE_IDLE_TIMEOUT_MS="30000"
PAYLOAD_SECRET=replace-me
CRON_SECRET=replace-me
PREVIEW_SECRET=replace-me
S3_ENABLED="false"
S3_CLIENT_UPLOADS="false"
MEDIA_ACCESS_CONTROL_ENABLED="true"
MEDIA_PRIVATE_DIRECTORY="/srv/novasite-media"
MEDIA_HOST_DIRECTORY="/srv/novasite-media"
MEDIA_REFERENCE_SCAN_LIMIT="5000"
PRODUCT_TRANSLATION_QUEUE_ENABLED="true"
TRANSLATION_WORKER_CONCURRENCY="1"
INQUIRY_PERSISTENCE_ENABLED="true"
INQUIRY_NOTIFICATIONS_ENABLED="false"
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL="deepseek-flash"
TLS_CONTACT_EMAIL="REPLACE_OWNER_EMAIL"
APP_IMAGE="novasite-web:v1-rc-20261004-2"
TRANSLATION_WORKER_IMAGE="novasite-worker:v1-rc-20261003-2-loader1"
MIGRATOR_IMAGE="novasite-single-tools:v1-rc-20261003-2-loader1"
POSTGRES_IMAGE="postgres:17.11-bookworm"
CADDY_IMAGE="caddy:2.11.2-alpine"
POSTGRES_DATA_DIRECTORY="/srv/novasite-postgres"
POSTGRES_TLS_DIRECTORY="/srv/novasite-config/tls"
POSTGRES_ENV_FILE="/srv/novasite-config/postgres.env"
PLATFORM_ENV_FILE="/srv/novasite-config/runtime.env"
BOOTSTRAP_ADMIN_EMAIL="REPLACE_OWNER_EMAIL"
