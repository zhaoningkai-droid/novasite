# Copy to deploy/.env.production on the test server. Never commit that file.
POSTGRES_DB=novasite_test
POSTGRES_USER=novasite
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://novasite:REPLACE_WITH_A_LONG_UNIQUE_PASSWORD@postgres:5432/novasite_test

PAYLOAD_SECRET=replace-me
CRON_SECRET=replace-me
PREVIEW_SECRET=replace-me

# Public test site. DNS A/AAAA must already point at this server.
SITE_DOMAIN=example.com
SITE_SLUG=your-test-company-slug
SITE_LOCALE=zh
NEXT_PUBLIC_SERVER_URL=https://admin.example.com

# Production-style object storage is mandatory for uploads.
S3_ENABLED=true
S3_ENDPOINT=https://YOUR-S3-COMPATIBLE-ENDPOINT
S3_BUCKET=novasite-test-media
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false
S3_CLIENT_UPLOADS=true
REDIS_URL=redis://YOUR_MANAGED_REDIS_HOST:6379
