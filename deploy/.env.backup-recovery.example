# Maintenance-computer configuration only. Never put the private identity on the web server.
# Do not copy application/AI/mail/database-write/backup-upload credentials here.
BACKUP_RECOVERY_ENABLED=false
BACKUP_RECOVERY_DIRECTORY=/YOUR_PRIVATE_DIRECTORY/novasite-backup-recovery
BACKUP_RECOVERY_AGE_IDENTITY_FILE=/YOUR_PRIVATE_OFFLINE_DIRECTORY/novasite-backup-key.txt
BACKUP_RECOVERY_MAX_CIPHERTEXT_BYTES=549755813888
BACKUP_RECOVERY_MAX_PLAINTEXT_BYTES=549755813888
BACKUP_RECOVERY_MAX_ENTRIES=300000
BACKUP_RECOVERY_MAX_FILE_BYTES=68719476736
BACKUP_RECOVERY_TIMEOUT_MINUTES=240
BACKUP_RECOVERY_MIN_FREE_BYTES=21474836480

# Read-only access to specified versions in the independently selected backup bucket.
# No upload, delete, bucket-policy modification, or website media permissions.
# Values must exactly match the separately saved trusted upload receipt.
BACKUP_RESTORE_S3_ENDPOINT=https://YOUR_BACKUP_STORAGE_ORIGIN
BACKUP_RESTORE_S3_BUCKET=REPLACE_PRIVATE_OFFSITE_BUCKET
BACKUP_RESTORE_S3_REGION=REPLACE_BACKUP_REGION
BACKUP_RESTORE_S3_ACCESS_KEY=replace-me
BACKUP_RESTORE_S3_SECRET_KEY=replace-me
BACKUP_RESTORE_S3_FORCE_PATH_STYLE=false
# BACKUP_RESTORE_S3_SESSION_TOKEN=OPTIONAL_TEMPORARY_SESSION_TOKEN
