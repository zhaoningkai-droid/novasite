# Deployment candidate: copy to deploy/.env.platform; keep it private (chmod 600).
# These values describe your platform, not a fixed individual customer.
PLATFORM_DOMAINS_ENABLED=true
PLATFORM_ROOT_DOMAIN=example.com
PLATFORM_ADMIN_HOST=admin.example.com
NEXT_PUBLIC_SERVER_URL=https://admin.example.com
TLS_CONTACT_EMAIL=REPLACE_WITH_YOUR_OPERATIONS_EMAIL
# Start certificate rehearsals with the staging CA; switch only after rehearsal.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Build all three images from one release and retain the previous release tags.
APP_IMAGE=novasite-platform:REPLACE_RELEASE
TRANSLATION_WORKER_IMAGE=novasite-translation-worker:REPLACE_RELEASE
MIGRATOR_IMAGE=novasite-migrator:REPLACE_RELEASE
# Pin a reviewed image digest before formal deployment.
CADDY_IMAGE=caddy:2-alpine

# Same-region managed PostgreSQL; no container database or public database port.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PRIVATE_DB_HOST:5432/REPLACE_DATABASE?sslmode=verify-full
# Runtime app/workers use the provider CA and validate both certificate chain and host.
DATABASE_TLS_ENABLED=true
# Per-process limits. Example total: web 10 + translation 4 + optional mail 2 + migrator 2.
# Tune against the actual provider limit; leave room for backups, monitoring and recovery.
DATABASE_WEB_POOL_MAX=10
DATABASE_TRANSLATION_POOL_MAX=4
DATABASE_NOTIFICATION_POOL_MAX=2
DATABASE_MIGRATOR_POOL_MAX=2
# Fill from the purchased database's real max_connections; this is not queried by preflight.
DATABASE_CONNECTION_LIMIT=REPLACE_ACTUAL_PROVIDER_MAX_CONNECTIONS
DATABASE_RESERVED_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
# Database maintenance tools do not run during build/start/restart.
# Choose tools matching the actual managed database major version, then pin a digest.
POSTGRES_TOOLS_RUNTIME=docker
POSTGRES_TOOLS_IMAGE=REPLACE_WITH_POSTGRES_TOOLS_IMAGE_AND_SHA256_DIGEST
# Optional local client alternative: runtime=local, with an absolute bin directory.
# POSTGRES_TOOLS_BIN_DIR=/absolute/path/to/postgresql/bin
POSTGRES_TOOL_TIMEOUT_MINUTES=60
PLATFORM_BACKUP_DIRECTORY=/srv/novasite-backups
# Provider's public CA PEM on the host. Ordinary readable file, never a client private key.
# Compose mounts it read-only into all database consumers and sets their container path.
# Maintenance CLI still reads this host path; do not replace it with the container path here.
DATABASE_CA_FILE=/absolute/path/to/provider-database-ca.pem
# Reference to a separately saved media snapshot; this does not back up media itself.
MEDIA_BACKUP_CHECKPOINT=UNSET
# Daily encrypted remote backup uses deploy/.env.backup.example and a separate
# systemd timer. It remains disabled until resources and recovery are confirmed.
# A separately created empty database only. Never point application/workers at it yet.
RESTORE_DATABASE_URL=postgresql://REPLACE_RESTORE_USER:REPLACE_PASSWORD@REPLACE_PRIVATE_DB_HOST:5432/novasite_restore_REPLACE_NAME?sslmode=verify-full
RESTORE_DATABASE_CA_FILE=/absolute/path/to/provider-database-ca.pem
PAYLOAD_SECRET=replace-me
CRON_SECRET=replace-me
PREVIEW_SECRET=replace-me

S3_ENABLED=true
# Provider API origin only: no bucket/key path, credentials or query string.
# Existing object keys keep their media prefix; changing the bucket does not copy files.
S3_ENDPOINT=https://REPLACE_WITH_YOUR_STORAGE_ENDPOINT
S3_BUCKET=REPLACE_WITH_A_PRIVATE_WRITE_MEDIA_BUCKET
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=REPLACE_WITH_YOUR_BUCKET_REGION
S3_FORCE_PATH_STYLE=false
# First deployment uses authenticated server uploads; direct browser upload later.
S3_CLIENT_UPLOADS=false
# Prepare files/private bucket, then rehearse permissions before enabling this.
# The candidate intentionally fails the formal release gate until this is true.
MEDIA_ACCESS_CONTROL_ENABLED=false
# Local fallback only; must be outside public, privately mounted and populated first.
MEDIA_PRIVATE_DIRECTORY=/srv/novasite-media
# Bounded rich-text/legacy URL lookup; exhausting it denies access with 503.
MEDIA_REFERENCE_SCAN_LIMIT=5000
# Bucket policies (outside application code) must deny anonymous direct access.
# Prepare object versioning/independent media backups before a real storage cutover.

# Operator-only file tools. These do not run with build/start/restart or on a timer.
PLATFORM_MEDIA_BACKUP_DIRECTORY=/srv/novasite-backups/media
MEDIA_BACKUP_MAX_FILES=100000
MEDIA_BACKUP_MAX_BYTES=268435456000
MEDIA_BACKUP_MAX_FILE_BYTES=2147483648
MEDIA_BACKUP_MAX_VERSIONS=1000000
MEDIA_BACKUP_TIMEOUT_MINUTES=180
# Backup credentials MUST be separate read-only credentials; no fallback to upload keys.
# Endpoint/bucket/region/path style default to the above S3 values if omitted.
MEDIA_BACKUP_S3_ACCESS_KEY=replace-me
MEDIA_BACKUP_S3_SECRET_KEY=replace-me
# MEDIA_BACKUP_S3_SESSION_TOKEN=OPTIONAL_TEMPORARY_SESSION_TOKEN
# MEDIA_BACKUP_S3_ENDPOINT=https://YOUR_SOURCE_STORAGE_ENDPOINT
# MEDIA_BACKUP_S3_BUCKET=YOUR_SOURCE_BUCKET
# MEDIA_BACKUP_S3_REGION=YOUR_SOURCE_REGION
# MEDIA_BACKUP_S3_FORCE_PATH_STYLE=false

# Restore to a separately created EMPTY versioned bucket only; never the application bucket.
# These values do not change the application S3 configuration or create a bucket.
RESTORE_S3_ENDPOINT=https://REPLACE_WITH_YOUR_RESTORE_STORAGE_ENDPOINT
RESTORE_S3_BUCKET=novasite-restore-REPLACE_NAME
RESTORE_S3_REGION=REPLACE_WITH_YOUR_RESTORE_REGION
RESTORE_S3_ACCESS_KEY=replace-me
RESTORE_S3_SECRET_KEY=replace-me
RESTORE_S3_FORCE_PATH_STYLE=false
# RESTORE_S3_SESSION_TOKEN=OPTIONAL_TEMPORARY_SESSION_TOKEN

PRODUCT_TRANSLATION_QUEUE_ENABLED=true
# Replace the key previously shared in chat before entering a production key here.
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-flash

# Translation usage is recorded without an application quota. Install the usage schema before deployment.
PLATFORM_OPERATIONS_DIRECTORY=/srv/novasite-operations
# Optional reporting-only DB account: SELECT on translation_usage, no write privileges.
# TRANSLATION_USAGE_DATABASE_URL=postgresql://READONLY_USER:READONLY_PASSWORD@PRIVATE_DB_HOST:5432/DATABASE?sslmode=verify-full
# TRANSLATION_USAGE_DATABASE_CA_FILE=/absolute/path/to/provider-database-ca.pem

# Enable persistence only after approved backup, migration and isolated rehearsal.
INQUIRY_PERSISTENCE_ENABLED=true
# Notifications are opt-in. Enabling later does not send old disabled notifications.
INQUIRY_NOTIFICATIONS_ENABLED=false
SMTP_HOST=REPLACE_WITH_YOUR_SMTP_HOST
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_YOUR_SMTP_ACCOUNT
SMTP_PASSWORD=replace-me
SMTP_FROM_ADDRESS=REPLACE_WITH_A_VERIFIED_SENDER_ADDRESS
SMTP_FROM_NAME=NovaSite
