# Separate maintenance configuration. Never copy AI, email, PAYLOAD_SECRET,
# application database-write credentials or media write keys into this file.
BACKUP_AUTOMATION_ENABLED=false
BACKUP_OFFSITE_CONFIRMED=false
BACKUP_JOB_DIRECTORY=/srv/novasite-backups/jobs
BACKUP_AGE_RECIPIENT_FILE=/srv/novasite-backup-config/recipients.txt
BACKUP_JOB_TIMEOUT_MINUTES=240
BACKUP_MAX_CIPHERTEXT_BYTES=549755813888
BACKUP_MIN_FREE_BYTES=21474836480
BACKUP_STALE_HOURS=36
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Choose the actual media mode. S3 source must have versioning enabled.
BACKUP_MEDIA_SOURCE_MODE=s3
# BACKUP_LOCAL_MEDIA_DIRECTORY=/srv/novasite-media
MEDIA_BACKUP_MAX_FILES=100000
MEDIA_BACKUP_MAX_BYTES=268435456000
MEDIA_BACKUP_MAX_FILE_BYTES=2147483648
MEDIA_BACKUP_MAX_VERSIONS=1000000
MEDIA_BACKUP_TIMEOUT_MINUTES=180
MEDIA_BACKUP_S3_ENDPOINT=https://YOUR_SOURCE_STORAGE_ORIGIN
MEDIA_BACKUP_S3_BUCKET=REPLACE_SOURCE_MEDIA_BUCKET
MEDIA_BACKUP_S3_REGION=REPLACE_SOURCE_REGION
MEDIA_BACKUP_S3_ACCESS_KEY=replace-me
MEDIA_BACKUP_S3_SECRET_KEY=replace-me
MEDIA_BACKUP_S3_FORCE_PATH_STYLE=false

# Read-only user able to export every application schema; same-region TLS.
DATABASE_URL=postgresql://REPLACE_BACKUP_USER:REPLACE_PASSWORD@REPLACE_DATABASE_HOST:5432/REPLACE_DATABASE?sslmode=verify-full
DATABASE_CA_FILE=/srv/novasite-backup-config/database-ca.pem
POSTGRES_TOOLS_RUNTIME=docker
POSTGRES_TOOLS_IMAGE=REPLACE_MATCHING_POSTGRES_IMAGE_AND_SHA256_DIGEST
POSTGRES_TOOL_TIMEOUT_MINUTES=60
# Alternative: local runtime + installed same-major clients.
# POSTGRES_TOOLS_BIN_DIR=/absolute/path/to/postgresql/bin

# A separately selected private backup bucket, account/region and credentials.
# Target must support version IDs, conditional writes, checksum reads,
# GetPublicAccessBlock and GetBucketPolicyStatus; compatibility is not assumed.
BACKUP_S3_ENDPOINT=https://YOUR_BACKUP_STORAGE_ORIGIN
BACKUP_S3_BUCKET=REPLACE_PRIVATE_OFFSITE_BUCKET
BACKUP_S3_REGION=REPLACE_BACKUP_REGION
BACKUP_S3_ACCESS_KEY=replace-me
BACKUP_S3_SECRET_KEY=replace-me
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_KEY_PREFIX=novasite-backups
# BACKUP_S3_SESSION_TOKEN=OPTIONAL_TEMPORARY_SESSION_TOKEN
# Backup IAM must deny delete and changing bucket policy/versioning.
