# Database connection string
DATABASE_URL=postgresql://novasite:novasite@127.0.0.1:5433/novasite

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Optional: Redis queue/cache and S3-compatible object storage
REDIS_URL=redis://127.0.0.1:6380
S3_ENABLED=false
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=novasite-media
S3_ACCESS_KEY=novasite
S3_SECRET_KEY=novasite-local-secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_CLIENT_UPLOADS=false
